<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/player_image_content_desc"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <include
        android:id="@+id/urgentOverlay"
        layout="@layout/view_urgent_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/player_empty"
        android:textColor="@color/televisor_muted"
        android:textSize="22sp"
        android:visibility="gone" />

    <include
        android:id="@+id/tickerOverlay"
        layout="@layout/view_ticker_bar"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom" />
</FrameLayout>
