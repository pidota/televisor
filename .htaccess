<IfModule mod_rewrite.c>
    RewriteEngine On
    # Listas y segmentos HLS de MediaMTX. La ruta pública coincide con la que anuncia el servidor.
    RewriteRule ^(.+\.(?:m3u8|ts|m4s))$ http://127.0.0.1:8888/televisor/$1 [P,L,QSA]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule php_module>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
